<Page
    x:Class="WalkerMediaManager.UI.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="40" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="Collections" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Track collection progress, find missing movies, and browse your custom collections."
                    Style="{ThemeResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Content="Refresh"
                Padding="20,10"
                VerticalAlignment="Center"
                Click="RefreshButton_Click" />
        </Grid>

        <Pivot Grid.Row="1">
            <PivotItem Header="Automatic Collections">
                <Grid Padding="0,14,0,0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="SeriesSearchBox"
                            PlaceholderText="Search collection or movie title..."
                            TextChanged="SeriesSearchBox_TextChanged" />

                        <ComboBox
                            x:Name="CategoryFilterBox"
                            Grid.Column="1"
                            Header="Category"
                            ItemsSource="{x:Bind Categories, Mode=OneWay}"
                            SelectedIndex="0"
                            SelectionChanged="SeriesFilter_SelectionChanged" />

                        <ComboBox
                            x:Name="StudioFilterBox"
                            Grid.Column="2"
                            Header="Studio"
                            ItemsSource="{x:Bind Studios, Mode=OneWay}"
                            SelectedIndex="0"
                            SelectionChanged="SeriesFilter_SelectionChanged" />

                        <ComboBox
                            x:Name="SeriesStatusFilter"
                            Grid.Column="3"
                            Header="Status"
                            SelectedIndex="0"
                            SelectionChanged="SeriesFilter_SelectionChanged">
                            <ComboBoxItem Content="All Collections" Tag="All" />
                            <ComboBoxItem Content="Complete" Tag="Complete" />
                            <ComboBoxItem Content="Almost Complete" Tag="Almost" />
                            <ComboBoxItem Content="In Progress" Tag="InProgress" />
                            <ComboBoxItem Content="Not Started" Tag="NotStarted" />
                            <ComboBoxItem Content="Has Wishlist Items" Tag="Wishlist" />
                            <ComboBoxItem Content="Needs Planning" Tag="Unplanned" />
                        </ComboBox>

                        <ComboBox
                            x:Name="SeriesSortBox"
                            Grid.Column="4"
                            Header="Sort"
                            SelectedIndex="0"
                            SelectionChanged="SeriesFilter_SelectionChanged">
                            <ComboBoxItem Content="Progress" Tag="Progress" />
                            <ComboBoxItem Content="Name" Tag="Name" />
                            <ComboBoxItem Content="Fewest Missing" Tag="Missing" />
                            <ComboBoxItem Content="Largest Collection" Tag="Size" />
                            <ComboBoxItem Content="Smart Priority" Tag="Smart" />
                            <ComboBoxItem Content="Cost: Low to High" Tag="CostLow" />
                            <ComboBoxItem Content="Cost: High to Low" Tag="CostHigh" />
                        </ComboBox>

                        <TextBlock
                            x:Name="SeriesCountText"
                            Grid.Column="5"
                            VerticalAlignment="Bottom"
                            Margin="4,0,0,9"
                            FontWeight="SemiBold"
                            Text="0 collections" />
                    </Grid>

                    <Expander
                        Grid.Row="1"
                        Header="Collection summary and budget planner"
                        IsExpanded="False">
                        <StackPanel Spacing="12" Padding="0,10,0,2">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3"><TextBlock Text="Complete" Opacity="0.7"/><TextBlock x:Name="SmartCompleteText" Text="0" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3"><TextBlock Text="Almost complete" Opacity="0.7"/><TextBlock x:Name="SmartAlmostText" Text="0" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3"><TextBlock Text="Missing titles" Opacity="0.7"/><TextBlock x:Name="SmartMissingText" Text="0" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Grid.Column="3" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3"><TextBlock Text="On wishlist" Opacity="0.7"/><TextBlock x:Name="SmartWishlistText" Text="0" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Grid.Column="4" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3"><TextBlock Text="Estimated to complete" Opacity="0.7"/><TextBlock x:Name="SmartCostText" Text="$0.00" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                            </Grid>

                            <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Budget Shopping Planner" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="Build a prioritized purchase list with the biggest collection impact." Opacity="0.72" />
                                        </StackPanel>
                                        <TextBox x:Name="BudgetBox" Grid.Column="1" Header="Budget" PlaceholderText="100.00" InputScope="Number" />
                                        <Button Grid.Column="2" Content="Build Plan" Padding="18,9" VerticalAlignment="Bottom" Click="BuildShoppingPlanButton_Click" />
                                    </Grid>
                                    <StackPanel x:Name="ShoppingPlanPanel" Visibility="Collapsed" Spacing="8">
                                        <TextBlock x:Name="ShoppingPlanSummaryText" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{x:Bind ShoppingRecommendations, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0,4" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title.DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Collection.Name}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2" Text="{Binding PriceDisplay}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding ImpactDisplay}" FontWeight="SemiBold" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <InfoBar
                        x:Name="AutomaticStatusInfoBar"
                        Grid.Row="2"
                        IsOpen="False"
                        IsClosable="True" />

                    <Border
                        Grid.Row="3"
                        Padding="12,8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="115" />
                                <ColumnDefinition Width="185" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Collection" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Category" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Studio" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Owned" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="Missing" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="Progress" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="Next purchase" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="7" Text="Est. cost" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="8" Text="Actions" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="AutomaticSeriesListView"
                        Grid.Row="4"
                        ItemsSource="{x:Bind FilteredSeries, Mode=OneWay}"
                        SelectionMode="None"
                        IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="54" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="185" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CompletionCategory}" FontSize="11" Opacity="0.65" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Studio}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding OwnedCount}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="{Binding MissingCount}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="5" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompletionDisplay}" FontSize="12" />
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding CompletionPercent}" Height="5" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="{Binding RecommendedNextDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="7" Text="{Binding CompletionCostDisplay}" VerticalAlignment="Center" FontSize="12" />
                                    <Grid Grid.Column="8" ColumnSpacing="6" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Add Missing" Tag="{Binding}" Click="AddMissingToWishlistButton_Click" Padding="10,6" />
                                        <Button Grid.Column="1" Content="Open" Tag="{Binding}" Click="ViewSeriesButton_Click" Padding="12,6" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Manual Collections">
                <Grid Padding="0,18,0,0" RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Padding="20"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">

                        <StackPanel Spacing="16">
                            <TextBlock x:Name="FormTitleText" Text="Add Collection" FontSize="22" FontWeight="SemiBold" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="NameBox" Header="Collection Name" PlaceholderText="My favorite westerns" />
                                <TextBox x:Name="OwnedCountBox" Grid.Column="1" Header="Titles Owned" PlaceholderText="6" InputScope="Number" />
                                <TextBox x:Name="TargetCountBox" Grid.Column="2" Header="Total Titles" PlaceholderText="8" InputScope="Number" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="DescriptionBox" Header="Description" PlaceholderText="Optional notes about this collection" />
                                <Button x:Name="SaveButton" Grid.Column="1" Content="Add Collection" Padding="22,10" VerticalAlignment="Bottom" Click="SaveButton_Click" />
                                <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Padding="18,10" VerticalAlignment="Bottom" Visibility="Collapsed" Click="CancelButton_Click" />
                            </Grid>

                            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CollectionCountText" Text="0 collections" FontSize="20" FontWeight="SemiBold" />

                        <ListView x:Name="CollectionsListView" Grid.Row="1" ItemsSource="{x:Bind Collections, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.65" />
                                                <TextBlock Text="{Binding MissingDisplay}" Opacity="0.75" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProgressDisplay}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CompletionDisplay}" Opacity="0.7" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="Edit" Tag="{Binding}" Click="EditButton_Click" />
                                            <Button Grid.Column="3" Content="Delete" Tag="{Binding}" Click="DeleteButton_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
