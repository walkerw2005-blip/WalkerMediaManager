<Page
    x:Class="WalkerMediaManager.UI.Views.CollectionIntelligencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WalkerMediaManager.UI.Models"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Padding="40" Spacing="22">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="Collection Intelligence" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Find duplicates, upgrade opportunities, incomplete goals, and items currently on loan."
                               Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="RefreshButton_Click" VerticalAlignment="Center" />
            </Grid>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />
            <ProgressRing x:Name="LoadingRing" IsActive="False" HorizontalAlignment="Left" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="5"><TextBlock Text="Owned titles" Opacity="0.7"/><TextBlock x:Name="OwnedTitlesText" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="TotalCopiesText" Opacity="0.7"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="5"><TextBlock Text="Estimated replacement value" Opacity="0.7"/><TextBlock x:Name="ReplacementValueText" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Uses recorded prices and format estimates" Opacity="0.7" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="5"><TextBlock Text="Duplicate titles" Opacity="0.7"/><TextBlock x:Name="DuplicateCountText" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Titles with more than one owned copy" Opacity="0.7" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="5"><TextBlock Text="Upgrade opportunities" Opacity="0.7"/><TextBlock x:Name="UpgradeCountText" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="DVD/Blu-ray titles without a newer format" Opacity="0.7" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="5"><TextBlock Text="Active loans" Opacity="0.7"/><TextBlock x:Name="ActiveLoansText" FontSize="28" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="5"><TextBlock Text="Incomplete goals" Opacity="0.7"/><TextBlock x:Name="IncompleteGoalsText" FontSize="28" FontWeight="SemiBold"/></StackPanel>
                </Border>
            </Grid>

            <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Loan tracking" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock Text="Keep track of physical copies borrowed by friends or family." Opacity="0.7"/></StackPanel>
                        <Button Grid.Column="1" Content="Add loan" Click="AddLoanButton_Click" />
                    </Grid>
                    <ListView x:Name="LoansList" SelectionMode="Single" MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LoanRecord">
                                <Grid Padding="6" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{x:Bind TitleDisplay}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind CopyDisplay}" Opacity="0.68"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Borrower}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind LoanedDateDisplay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind DueDateDisplay}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Content="Mark returned" Tag="{Binding}" Click="MarkReturnedButton_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoLoansText" Text="No items are currently on loan." Opacity="0.7" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Duplicate ownership" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Multiple formats or editions can be intentional; this list helps spot accidental duplicates." Opacity="0.7" TextWrapping="Wrap"/>
                        <ListView x:Name="DuplicatesList" SelectionMode="None" MaxHeight="430">
                            <ListView.ItemTemplate><DataTemplate x:DataType="models:DuplicateOwnershipItem"><Grid Padding="6" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind TitleDisplay}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Formats}" Opacity="0.68" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{x:Bind CopyCountDisplay}"/><TextBlock Text="{x:Bind RecordedValueDisplay}" Opacity="0.68"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Upgrade opportunities" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Format-based suggestions only; availability and mastering quality are not considered." Opacity="0.7" TextWrapping="Wrap"/>
                        <ListView x:Name="UpgradesList" SelectionMode="None" MaxHeight="430">
                            <ListView.ItemTemplate><DataTemplate x:DataType="models:UpgradeOpportunityItem"><StackPanel Padding="6"><TextBlock Text="{x:Bind TitleDisplay}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind CurrentFormats}" Opacity="0.68"/><TextBlock Text="{x:Bind Recommendation}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Collection goals" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Incomplete goals from the Collections page." Opacity="0.7"/>
                    <ListView x:Name="GoalsList" SelectionMode="None" MaxHeight="350">
                        <ListView.ItemTemplate><DataTemplate x:DataType="models:MediaCollection"><Grid Padding="6" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Description}" Opacity="0.68" TextTrimming="CharacterEllipsis"/></StackPanel><ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind CompletionPercent}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{x:Bind ProgressDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
