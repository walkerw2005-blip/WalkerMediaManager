<Page
    x:Class="WalkerMediaManager.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WalkerMediaManager.UI.Models">

    <ScrollViewer>
        <StackPanel Padding="40" Spacing="28">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="Interactive Analytics" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="Insights, milestones, activity, and collection trends." Style="{ThemeResource SubtitleTextBlockStyle}"/>
                </StackPanel>
                <ProgressRing x:Name="DashboardProgressRing" Grid.Column="1" Width="28" Height="28" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center"/>
            </Grid>

            <InfoBar x:Name="DashboardErrorInfoBar" IsOpen="False" IsClosable="True"/>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><FontIcon Glyph="&#xE714;" FontSize="26" HorizontalAlignment="Left"/><TextBlock x:Name="MovieCountText" Text="0" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Movies" Opacity="0.7"/></StackPanel></Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><FontIcon Glyph="&#xE7F4;" FontSize="26" HorizontalAlignment="Left"/><TextBlock x:Name="TvSeriesCountText" Text="0" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="TV Series" Opacity="0.7"/></StackPanel></Border>
                <Border Grid.Row="0" Grid.Column="2" Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><FontIcon Glyph="&#xE823;" FontSize="26" HorizontalAlignment="Left"/><TextBlock x:Name="RuntimeText" Text="Unavailable" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Movie Runtime" Opacity="0.7"/></StackPanel></Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><FontIcon Glyph="&#xE8F1;" FontSize="26" HorizontalAlignment="Left"/><TextBlock x:Name="OwnedTitleCountText" Text="0" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Owned Titles" Opacity="0.7"/></StackPanel></Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="26" HorizontalAlignment="Left"/><TextBlock x:Name="WishlistCountText" Text="0" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Wishlist Items" Opacity="0.7"/></StackPanel></Border>
                <Border Grid.Row="1" Grid.Column="2" Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><FontIcon Glyph="&#xE8D5;" FontSize="26" HorizontalAlignment="Left"/><TextBlock x:Name="CollectionCountText" Text="0" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="CollectionSummaryText" Text="Collections" Opacity="0.7"/></StackPanel></Border>
            </Grid>

            <Border Padding="24" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" FontSize="40" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5"><TextBlock Text="Collection Progress" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="AverageCompletionText" Text="0% average completion"/><ProgressBar x:Name="AverageCompletionBar" Minimum="0" Maximum="100" Height="8" Margin="0,5,0,0"/></StackPanel>
                    <Button Grid.Column="2" Content="Open Collections" Padding="18,10" VerticalAlignment="Center" Click="OpenCollections_Click"/>
                </Grid>
            </Border>

            <StackPanel Spacing="14">
                <TextBlock Text="Smart Insights" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="InsightsEmptyText" Text="No new insights are available yet." Opacity="0.7" Visibility="Collapsed"/>
                <ItemsControl x:Name="InsightsList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:DashboardInsight">
                    <Border Margin="0,0,0,10" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="26" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" Opacity="0.8"/></StackPanel>
                            <Button Grid.Column="2" Content="{x:Bind ActionLabel}" Tag="{x:Bind ActionKey}" Click="InsightAction_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="22" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="14"><TextBlock Text="Top Genres" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="GenresEmptyText" Text="No genre data." Opacity="0.7" Visibility="Collapsed"/><ItemsControl x:Name="TopGenresList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:DashboardBreakdownItem"><StackPanel Spacing="5" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind CountDisplay}" Opacity="0.7"/></Grid><ProgressBar Maximum="100" Value="{x:Bind Percent}" Height="7"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="1" Padding="22" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="14"><TextBlock Text="Movies by Decade" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DecadesEmptyText" Text="No release-year data." Opacity="0.7" Visibility="Collapsed"/><ItemsControl x:Name="DecadesList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:DashboardBreakdownItem"><StackPanel Spacing="5" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind CountDisplay}" Opacity="0.7"/></Grid><ProgressBar Maximum="100" Value="{x:Bind Percent}" Height="7"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="2" Padding="22" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="14"><TextBlock Text="Format Distribution" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="FormatsEmptyText" Text="No format data." Opacity="0.7" Visibility="Collapsed"/><ItemsControl x:Name="FormatsList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:DashboardBreakdownItem"><StackPanel Spacing="5" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind CountDisplay}" Opacity="0.7"/></Grid><ProgressBar Maximum="100" Value="{x:Bind Percent}" Height="7"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </Grid>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="24" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="16"><TextBlock Text="Achievements" FontSize="22" FontWeight="SemiBold"/><ItemsControl x:Name="AchievementsList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:Achievement"><Grid Margin="0,0,0,14" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="{x:Bind Glyph}" FontSize="24" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Description}" Opacity="0.7"/><ProgressBar Maximum="100" Value="{x:Bind Progress}" Height="6"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind StatusDisplay}" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="1" Padding="24" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="16"><TextBlock Text="Recent Activity" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ActivityEmptyText" Text="No recent activity is available." Opacity="0.7" Visibility="Collapsed"/><ItemsControl x:Name="ActivityList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ActivityEvent"><Grid Margin="0,0,0,14" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="{x:Bind Glyph}" FontSize="22"/><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" Opacity="0.7"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind DateDisplay}" Opacity="0.6"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </Grid>

            <StackPanel Spacing="12"><TextBlock Text="Quick Actions" FontSize="22" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Recommendations" Click="OpenRecommendations_Click"/><Button Content="Shopping Planner" Click="OpenCollections_Click"/><Button Content="Wishlist" Click="OpenWishlist_Click"/><Button Content="Smart Buy" Click="OpenSmartBuy_Click"/><Button Content="Movies" Click="OpenMovies_Click"/></StackPanel></StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
