<Page
    x:Class="WalkerMediaManager.UI.Views.WishlistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="40" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="Wishlist" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Keep track of movies and television shows you want to buy."
                Style="{ThemeResource SubtitleTextBlockStyle}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="18"
            CornerRadius="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="TitleBox"
                    Header="Title"
                    PlaceholderText="Enter a movie or TV-show title" />

                <ComboBox
                    x:Name="FormatComboBox"
                    Grid.Column="1"
                    Header="Preferred format"
                    SelectedIndex="0">
                    <ComboBoxItem Content="DVD" Tag="DVD" />
                    <ComboBoxItem Content="Blu-ray" Tag="Blu-ray" />
                    <ComboBoxItem Content="4K UHD" Tag="4K UHD" />
                    <ComboBoxItem Content="Digital" Tag="Digital" />
                    <ComboBoxItem Content="Other" Tag="Other" />
                </ComboBox>

                <ComboBox
                    x:Name="PriorityComboBox"
                    Grid.Column="2"
                    Header="Priority"
                    SelectedIndex="1">
                    <ComboBoxItem Content="Low" Tag="1" />
                    <ComboBoxItem Content="Normal" Tag="2" />
                    <ComboBoxItem Content="High" Tag="3" />
                </ComboBox>

                <Button
                    x:Name="SaveButton"
                    Grid.Column="3"
                    Content="Add to Wishlist"
                    Padding="20,10"
                    VerticalAlignment="Bottom"
                    Click="SaveButton_Click" />

                <Button
                    x:Name="CancelButton"
                    Grid.Column="4"
                    Content="Cancel"
                    Padding="18,10"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"
                    Click="CancelButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="Search title, year, or preferred format"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />

            <TextBlock
                x:Name="WishlistCountText"
                Grid.Column="1"
                Text="0 wishlist items"
                FontSize="16"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView
                x:Name="WishlistListView"
                ItemsSource="{x:Bind WishlistItems, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="WishlistListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,10"
                            Padding="16"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="56"
                                    Height="72"
                                    CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE714;" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding YearDisplay}" Opacity="0.7" />
                                        <TextBlock Text="{Binding MediaType}" Opacity="0.7" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Preferred format" FontSize="12" Opacity="0.65" />
                                    <TextBlock Text="{Binding PreferredFormat}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Priority" FontSize="12" Opacity="0.65" />
                                    <TextBlock Text="{Binding Priority}" FontWeight="SemiBold" />
                                </StackPanel>

                                <Button Grid.Column="4" Content="Mark Purchased" Tag="{Binding}" Click="MarkPurchasedButton_Click" />
                                <Button Grid.Column="5" Content="Edit" Tag="{Binding}" Click="EditButton_Click" />
                                <Button Grid.Column="6" Content="Remove" Tag="{Binding}" Click="RemoveButton_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xEB51;" FontSize="56" Opacity="0.55" HorizontalAlignment="Center" />
                <TextBlock Text="Your wishlist is empty." FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="EmptyStateMessageText"
                    Text="Add movies or TV shows using the form above."
                    Opacity="0.7"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="460" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="3"
            IsOpen="False"
            IsClosable="True"
            VerticalAlignment="Top" />
    </Grid>
</Page>
