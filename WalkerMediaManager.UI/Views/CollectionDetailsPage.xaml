<Page
    x:Class="WalkerMediaManager.UI.Views.CollectionDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WalkerMediaManager.UI.Controls">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Content="Back" Click="BackButton_Click" VerticalAlignment="Top" />

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="PageTitleText" Text="Collection Details"
                           Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="CollectionMetadataText" Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="Open Wishlist" Click="OpenWishlistButton_Click" />
                <Button Content="Shopping Mode" Click="OpenShoppingModeButton_Click" />
            </StackPanel>
        </Grid>

        <Pivot Grid.Row="1" x:Name="DetailsPivot">
            <PivotItem Header="Overview">
                <ScrollViewer>
                    <Grid RowSpacing="22" Padding="0,4,12,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="22" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="24" RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="ProgressText" FontSize="24" FontWeight="SemiBold" />
                                    <ProgressBar x:Name="CompletionProgressBar" Minimum="0" Maximum="100" Height="8" />
                                    <TextBlock x:Name="CompletionText" Opacity="0.7" />
                                    <TextBlock x:Name="CollectionStatusText" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Owned" Opacity="0.65" />
                                    <TextBlock x:Name="OwnedCountText" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RuntimeText" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Missing" Opacity="0.65" />
                                    <TextBlock x:Name="MissingCountText" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WishlistCountText" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock Text="Estimated Cost" Opacity="0.65" />
                                    <TextBlock x:Name="EstimatedCostText" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="To complete collection" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" Spacing="4">
                                    <TextBlock Text="Release Years" Opacity="0.65" />
                                    <TextBlock x:Name="ReleaseYearsText" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TotalMoviesText" Opacity="0.7" />
                                </StackPanel>

                                <StackPanel Grid.Column="5" Spacing="4">
                                    <TextBlock Text="Preferred Format" Opacity="0.65" />
                                    <TextBlock x:Name="PreferredFormatText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="For planned purchases" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Row="1" Grid.ColumnSpan="6" Margin="0,8,0,0" Padding="16" CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Total Investment" Opacity="0.65" />
                                            <TextBlock x:Name="TotalInvestmentText" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Average Price" Opacity="0.65" />
                                            <TextBlock x:Name="AveragePriceText" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="Digital Copies" Opacity="0.65" />
                                            <TextBlock x:Name="DigitalCoverageText" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="3">
                                            <TextBlock Text="Formats" Opacity="0.65" />
                                            <TextBlock x:Name="FormatBreakdownText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Spacing="3">
                                            <TextBlock Text="Storage Locations" Opacity="0.65" />
                                            <TextBlock x:Name="StorageLocationsText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Spacing="12">
                            <TextBlock x:Name="OwnedHeadingText" Text="Owned Movies"
                                       FontSize="22" FontWeight="SemiBold" />

                            <GridView x:Name="OwnedMoviesGrid" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="OwnedMoviesGrid_ItemClick">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="180" Margin="0,0,12,12" Padding="10" CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <Border Height="235" CornerRadius="8"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <controls:CachedArtworkImage ArtworkPath="{Binding PosterPath}"
                                                                                 CacheKey="{Binding PlexRatingKey}" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" MaxLines="2" />
                                                <TextBlock Text="{Binding Year}" Opacity="0.65" />
                                                <TextBlock Text="{Binding OwnedCopyDetailsDisplay}" Opacity="0.8" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <TextBlock x:Name="NoOwnedMoviesText" Text="No movies from this collection are currently owned."
                                       Opacity="0.7" Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MissingHeadingText" Text="Missing Movies"
                                           FontSize="22" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button x:Name="AddAllMissingButton" Grid.Column="1"
                                        Content="Add All Missing to Wishlist"
                                        Click="AddAllMissingButton_Click"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <InfoBar x:Name="WishlistStatusBar" IsOpen="False" IsClosable="True" />

                            <ItemsControl x:Name="MissingMoviesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="16" CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding YearDisplay}" Opacity="0.65" />
                                                    <TextBlock Text="{Binding WishlistStatusDisplay}" Opacity="0.7" />
                                                    <TextBlock Text="{Binding PurchaseImpactDisplay}" Opacity="0.7" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding EstimatedPriceDisplay}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="Missing" Opacity="0.7" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="{Binding WishlistActionText}"
                                                        IsEnabled="{Binding CanAddToWishlist}"
                                                        Tag="{Binding}"
                                                        Click="AddMissingToWishlistButton_Click"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoMissingMoviesText" Text="Collection complete - you own every movie in this collection."
                                       Opacity="0.7" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Watch Order" x:Name="WatchOrderPivotItem">
                <ScrollViewer>
                    <StackPanel Spacing="18" Padding="0,4,12,24">
                        <Border x:Name="WatchOrderSummaryCard" Padding="22" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Watch Order" Opacity="0.65" />
                                    <ComboBox x:Name="WatchOrderComboBox" MinWidth="260"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="WatchOrderComboBox_SelectionChanged" />
                                    <TextBlock x:Name="WatchOrderDescriptionText" TextWrapping="Wrap" Opacity="0.72" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Owned" Opacity="0.65" />
                                    <TextBlock x:Name="WatchOwnedCountText" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Wishlist" Opacity="0.65" />
                                    <TextBlock x:Name="WatchWishlistCountText" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock Text="Missing" Opacity="0.65" />
                                    <TextBlock x:Name="WatchMissingCountText" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="WatchOrderProgressPanel" Spacing="7">
                            <TextBlock x:Name="WatchOrderProgressText" FontSize="18" FontWeight="SemiBold" />
                            <ProgressBar x:Name="WatchOrderProgressBar" Minimum="0" Maximum="100" Height="8" />
                        </StackPanel>

                        <ListView x:Name="WatchOrderList" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="WatchOrderList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14" CornerRadius="10"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Position}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" />
                                            </Border>

                                            <Border Grid.Column="1" Width="60" Height="88" CornerRadius="6"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <controls:CachedArtworkImage ArtworkPath="{Binding PosterPath}"
                                                                             CacheKey="{Binding PlexRatingKey}" />
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding YearDisplay}" Opacity="0.65" />
                                                <TextBlock Text="{Binding DetailText}" Opacity="0.72" />
                                            </StackPanel>

                                            <Border Grid.Column="3" Padding="12,6" CornerRadius="12"
                                                    Background="{Binding StatusBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="NoWatchOrdersText"
                                   Text="No curated watch order is available for this collection yet."
                                   Opacity="0.7" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
