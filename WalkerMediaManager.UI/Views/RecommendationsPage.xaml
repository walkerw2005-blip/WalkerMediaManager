<Page
    x:Class="WalkerMediaManager.UI.Views.RecommendationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WalkerMediaManager.UI.Models"
    xmlns:controls="using:WalkerMediaManager.UI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Smart Recommendations" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Ranked suggestions for the best movies to add next." Opacity="0.72" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
            <ComboBox x:Name="FilterComboBox" Grid.Column="1" Width="210" SelectedIndex="0" SelectionChanged="FilterComboBox_SelectionChanged">
                <ComboBoxItem Content="All recommendations" Tag="all" />
                <ComboBoxItem Content="Closest to completion" Tag="complete" />
                <ComboBoxItem Content="Wishlist" Tag="wishlist" />
                <ComboBoxItem Content="Watch order" Tag="watch" />
            </ComboBox>
            <Button Grid.Column="2" Content="Restore dismissed" Click="RestoreDismissedButton_Click" />
            <Button Grid.Column="3" Content="Refresh" Click="RefreshButton_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <ProgressRing x:Name="LoadingRing" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE8D4;" FontSize="42" Opacity="0.55" />
                <TextBlock Text="No recommendations found" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Add movies to your library or wishlist, then refresh." Opacity="0.7" />
            </StackPanel>

            <ListView x:Name="RecommendationsList" IsItemClickEnabled="False" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RecommendationItem">
                        <Border Margin="0,0,0,12" Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="92" Height="138" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Top">
                                    <controls:CachedArtworkImage ArtworkPath="{Binding PosterPath}" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind CollectionName}" FontSize="14" Opacity="0.72" />

                                    <Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="12" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind PriorityBadge}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>

                                    <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" MaxWidth="760" />

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind CollectionProgressDisplay}" Opacity="0.72" />
                                        <TextBlock Text="{x:Bind ProgressImpactDisplay}" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind CompletionAfterPurchasePercent}" Height="6" />

                                    <Expander Header="Why this recommendation?" HorizontalAlignment="Stretch">
                                        <ItemsControl ItemsSource="{x:Bind ExplanationItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="•" FontWeight="Bold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8" MinWidth="105">
                                    <TextBlock Text="{x:Bind Score}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="score" FontSize="12" Opacity="0.65" HorizontalAlignment="Center" />
                                    <Button Content="Open" Tag="{x:Bind}" Click="OpenButton_Click" HorizontalAlignment="Stretch" />
                                    <Button Content="Dismiss" Tag="{x:Bind}" Click="DismissButton_Click" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
