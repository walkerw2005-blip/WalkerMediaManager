<Page
    x:Class="WalkerMediaManager.UI.Views.SmartBuyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WalkerMediaManager.UI.Controls">

    <Grid Padding="40" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="Smart Buy 2.0" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Check ownership, formats, locations, and upgrade opportunities before you buy."
                Style="{ThemeResource SubtitleTextBlockStyle}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="24"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">

            <StackPanel Spacing="16">
                <TextBlock
                    Text="What are you thinking about buying?"
                    FontSize="22"
                    FontWeight="SemiBold" />

                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="SearchBox"
                        Header="Movie or TV-show title"
                        PlaceholderText="For example: Top Gun"
                        KeyDown="SearchBox_KeyDown" />

                    <ComboBox
                        x:Name="PlannedFormatComboBox"
                        Grid.Column="1"
                        Header="Planned format"
                        PlaceholderText="Any format"
                        SelectionChanged="PlannedFormatComboBox_SelectionChanged">
                        <x:String>4K UHD</x:String>
                        <x:String>Blu-ray</x:String>
                        <x:String>3D Blu-ray</x:String>
                        <x:String>DVD</x:String>
                        <x:String>Digital</x:String>
                        <x:String>VHS</x:String>
                        <x:String>LaserDisc</x:String>
                    </ComboBox>

                    <NumberBox
                        x:Name="PlannedPriceNumberBox"
                        Grid.Column="2"
                        Header="Price"
                        PlaceholderText="$0.00"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact" />

                    <Button
                        Grid.Column="3"
                        Content="Check purchase"
                        Padding="22,10"
                        VerticalAlignment="Bottom"
                        Click="SearchButton_Click" />

                    <Button
                        Grid.Column="4"
                        Content="Clear"
                        Padding="18,10"
                        VerticalAlignment="Bottom"
                        Click="ClearButton_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing
                        x:Name="SearchProgressRing"
                        Width="28"
                        Height="28"
                        IsActive="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="SearchStatusText"
                        VerticalAlignment="Center"
                        Opacity="0.7" />
                </StackPanel>

                <InfoBar x:Name="SearchInfoBar" IsOpen="False" IsClosable="True" />

                <Button
                    x:Name="AddToWishlistButton"
                    Content="Add Search to Wishlist"
                    Padding="22,10"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Click="AddToWishlistButton_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Purchase check" FontSize="24" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="ResultCountText"
                    Grid.Column="1"
                    Opacity="0.7"
                    VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel
                    x:Name="EmptyStatePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <FontIcon Glyph="&#xE7BF;" FontSize="48" Opacity="0.55" HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Search before you buy"
                        FontSize="22"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Enter a title and optionally select the format you are considering."
                        TextWrapping="Wrap"
                        MaxWidth="520"
                        TextAlignment="Center"
                        Opacity="0.7" />
                </StackPanel>

                <ListView
                    x:Name="ResultsListView"
                    ItemsSource="{x:Bind Results, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,14"
                                Padding="20"
                                CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="280" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="88" Height="132" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <controls:CachedArtworkImage
                                            ArtworkPath="{Binding PosterPath}"
                                            CacheKey="{Binding CacheKey}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding YearDisplay}" Opacity="0.75" />
                                        <TextBlock Text="{Binding Details}" Opacity="0.7" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding OwnershipSummary}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FormatSummary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LocationSummary}" Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="2"
                                        Padding="16"
                                        CornerRadius="10"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        VerticalAlignment="Stretch">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon
                                                    Glyph="{Binding RecommendationGlyph}"
                                                    FontSize="24"
                                                    Foreground="{Binding RecommendationColor}" />
                                                <TextBlock
                                                    Text="{Binding Recommendation}"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding RecommendationDetail}"
                                                TextWrapping="Wrap"
                                                Opacity="0.8" />
                                            <TextBlock
                                                Text="{Binding PlannedPriceDisplay}"
                                                FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
