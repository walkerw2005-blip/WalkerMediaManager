<Page
    x:Class="WalkerMediaManager.UI.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WalkerMediaManager.UI.Models"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Padding="40" Spacing="22">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock Text="Reports" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="Review ownership, spending, and collection completeness."
                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="Refresh"
                    Click="RefreshButton_Click"
                    VerticalAlignment="Center" />
            </Grid>

            <InfoBar
                x:Name="StatusInfoBar"
                IsOpen="False"
                IsClosable="True" />

            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                IsActive="False" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Owned copies" Opacity="0.72" />
                        <TextBlock x:Name="OwnedCopiesText" Text="0" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="OwnedMoviesText" Text="0 movies represented" Opacity="0.62" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Recorded collection value" Opacity="0.72" />
                        <TextBlock x:Name="CollectionValueText" Text="$0.00" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="AveragePriceText" Text="$0.00 average recorded price" Opacity="0.62" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Physical / digital" Opacity="0.72" />
                        <TextBlock x:Name="PhysicalDigitalText" Text="0 / 0" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Physical copies / digital copies" Opacity="0.62" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Records needing attention" Opacity="0.72" />
                        <TextBlock x:Name="NeedsAttentionText" Text="0" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Missing price, date, or location" Opacity="0.62" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="4" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Missing purchase price" Opacity="0.72" />
                            <TextBlock x:Name="MissingPriceText" Text="0" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Missing purchase date" Opacity="0.72" />
                            <TextBlock x:Name="MissingDateText" Text="0" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Missing storage location" Opacity="0.72" />
                            <TextBlock x:Name="MissingLocationText" Text="0" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Copies by format" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ListView x:Name="FormatBreakdownList" SelectionMode="None" MaxHeight="360">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ReportBreakdownItem">
                                    <Grid Padding="4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind CountDisplay}" Opacity="0.72" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ValueDisplay}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Recorded spending by store" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ListView x:Name="StoreBreakdownList" SelectionMode="None" MaxHeight="360">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ReportBreakdownItem">
                                    <Grid Padding="4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind CountDisplay}" Opacity="0.72" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ValueDisplay}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Recent purchases" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ListView x:Name="RecentPurchasesList" SelectionMode="None" MaxHeight="520">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OwnedCopyReportRow">
                                <Grid Padding="6" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind TitleDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind EditionDisplay}" Opacity="0.68" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind StoreDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind LocationDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind PurchasePriceDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind PurchaseDateDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Ownership records needing attention" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="These copies are missing a purchase price, purchase date, or storage location." Opacity="0.7" />
                    <ListView x:Name="MissingInformationList" SelectionMode="None" MaxHeight="460">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OwnedCopyReportRow">
                                <Grid Padding="6" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind TitleDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind EditionDisplay}" Opacity="0.68" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind StoreDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind LocationDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind PurchasePriceDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind PurchaseDateDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
