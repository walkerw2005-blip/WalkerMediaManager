<Page
    x:Class="WalkerMediaManager.UI.Views.ShoppingModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WalkerMediaManager.UI.Controls">

    <ScrollViewer>
        <Grid Padding="40" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="Shopping Mode" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Scan a barcode or search by title before buying another copy." Style="{ThemeResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Padding="24" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LookupBox" Header="Barcode or title" PlaceholderText="Scan UPC or type a title" KeyDown="LookupBox_KeyDown" />
                        <TextBox x:Name="StoreBox" Grid.Column="1" Header="Store" PlaceholderText="Walmart, Best Buy, Amazon..." />
                        <ComboBox x:Name="FormatBox" Grid.Column="2" Header="Planned format" PlaceholderText="Any format">
                            <x:String>4K UHD</x:String><x:String>Blu-ray</x:String><x:String>3D Blu-ray</x:String>
                            <x:String>DVD</x:String><x:String>Digital</x:String><x:String>VHS</x:String><x:String>LaserDisc</x:String>
                        </ComboBox>
                        <NumberBox x:Name="PriceBox" Grid.Column="3" Header="Price" Minimum="0" SpinButtonPlacementMode="Compact" />
                        <Button Grid.Column="4" Content="Check" VerticalAlignment="Bottom" Click="CheckButton_Click" />
                    </Grid>
                    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <Border x:Name="ResultPanel" Grid.Row="2" Padding="24" CornerRadius="12" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:CachedArtworkImage x:Name="PosterImage" Width="180" Height="270" />
                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="MetadataText" Opacity="0.75" />
                        <TextBlock x:Name="RecommendationText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="RecommendationDetailText" TextWrapping="Wrap" MaxWidth="760" />
                        <TextBlock x:Name="OwnedFormatsText" TextWrapping="Wrap" />
                        <TextBlock x:Name="LocationsText" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Buy" Tag="Bought" Click="DecisionButton_Click" />
                            <Button Content="Skip" Tag="Skipped" Click="DecisionButton_Click" />
                            <Button Content="Wishlist" Tag="Wishlist" Click="DecisionButton_Click" />
                            <Button Content="Assign barcode" Click="AssignBarcodeButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Padding="20" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Recent shopping activity" FontSize="20" FontWeight="SemiBold" />
                        <Button Content="Refresh" HorizontalAlignment="Right" Click="RefreshHistoryButton_Click" />
                    </Grid>
                    <ListView x:Name="HistoryList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding PlannedFormat}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Store}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Decision}" />
                                    <TextBlock Grid.Column="4" Text="{Binding DateDisplay}" Opacity="0.7" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
