<UserControl
    x:Class="WalkerMediaManager.UI.Controls.CachedArtworkImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ControlFillColorSecondaryBrush}">
        <Grid x:Name="FallbackPanel">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE7B8;" FontSize="58" Opacity="0.35" />
                <TextBlock Text="Artwork unavailable" Opacity="0.55" />
            </StackPanel>
        </Grid>
        <Image x:Name="ArtworkImage" Stretch="UniformToFill" Visibility="Collapsed" />
        <ProgressRing x:Name="LoadingRing" Width="34" Height="34" IsActive="False" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
